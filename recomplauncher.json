{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Super Monaco Duo-Remix Recomp",
  "game": {
    "kind": "folder",
    "label": "Folder with your Super Monaco GP (World) and Ayrton Senna's Super Monaco GP II (USA) ROMs"
  },
  "prepare": {
    "program": [".tools/python/python.exe"],
    "args": ["{install}/tools/recomplauncher_prepare.py", "--game", "{game}", "--install", "{install}"],
    "label": "Building both games from your ROMs",
    "timeout": 3600
  },
  "start": {
    "program": ["SuperMonacoDuoRecomp.exe"]
  }
}